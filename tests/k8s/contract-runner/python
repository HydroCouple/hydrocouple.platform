#!/bin/sh
# Stands in for the runner in the Kubernetes adapter contract tests. The adapter starts
# "python -m hydrocouple_platform.runner ...", and this does what HCP_TEST_BEHAVIOR says.
event() {
  printf 'HCP-EVENT {"event_id": "%s", "sequence": %s, "kind": "%s", "phase": "%s", "message": "%s", "occurred_at": "%s"}\n' \
    "$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')" "$1" "$2" "$3" "$4" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
event 0 lifecycle started "contract runner: ${HCP_TEST_BEHAVIOR:-ok}"
case "${HCP_TEST_BEHAVIOR:-ok}" in
  ok)
    event 1 progress running "half way"
    exit 0 ;;
  exit:*)
    echo "the runner failed: a line for the failure tail"
    exit "${HCP_TEST_BEHAVIOR#exit:}" ;;
  sleep)
    trap 'event 1 lifecycle failed "cancelled by the agent"; exit 14' TERM
    while :; do sleep 1; done ;;
  oom)
    head -c 4294967296 /dev/zero | tail > /dev/null ;;
  inspect)
    # What the runner can see: its arguments, secrets file, environment and identity.
    echo "args: $*"
    echo "secrets: $(cat "${HCP_RUNNER_SECRETS_FILE:-/dev/null}")"
    echo "spec-readable: $(test -r /var/run/hydrocouple/spec.json && echo yes || echo no)"
    echo "lease-visible: $(test -e /var/run/hydrocouple/lease.json && echo yes || echo no)"
    echo "sa-token: $(test -e /var/run/secrets/kubernetes.io/serviceaccount/token && echo yes || echo no)"
    echo "uid: $(id -u)"
    echo "root-writable: $(touch /x 2>/dev/null && echo yes || echo no)"
    echo "work-writable: $(touch /work/x 2>/dev/null && echo yes || echo no)"
    env | grep '^HCP_' | sed 's/^/env: /'
    exit 0 ;;
esac
exit 1
