{
  "control_plane": "https://REPLACE-platform.example.org",
  "store": "s3://REPLACE-bucket/hydrocouple?endpoint_url=https://REPLACE-minio.site.local&region=us-east-1",
  "egress": "summaries",
  "adapter": "kubernetes",
  "kubernetes": {
    "namespace": "hydrocouple",
    "queue_name": "hydrocouple",
    "max_cpu": 16,
    "max_memory_gib": 64,
    "scratch_gib": 100,
    "slots": 16,
    "runner_env_secret": "hcp-store-credentials"
  },
  "image_trust": {
    "keys": [
      "/etc/hydrocouple/keys/release.pub"
    ]
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 8081,
    "url": "http://hcp-agent-gateway.hydrocouple.svc:8081"
  }
}
