{
  "control_plane": "https://REPLACE-platform.example.org",
  "store": "azure://REPLACE-account/REPLACE-container/hydrocouple",
  "egress": "summaries",
  "adapter": "kubernetes",
  "kubernetes": {
    "namespace": "hydrocouple",
    "queue_name": "hydrocouple",
    "max_cpu": 16,
    "max_memory_gib": 64,
    "scratch_gib": 100,
    "slots": 16,
    "runner_pod_labels": {
      "azure.workload.identity/use": "true"
    }
  },
  "image_trust": {
    "keys": [
      "/etc/hydrocouple/keys/release.pub"
    ],
    "k8s_keychain": true
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 8081,
    "url": "http://hcp-agent-gateway.hydrocouple.svc:8081"
  }
}
